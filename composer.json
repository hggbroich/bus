{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-sodium": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "doctrine/dbal": "^3.10.6",
        "doctrine/doctrine-bundle": "^2.19.1",
        "doctrine/doctrine-migrations-bundle": "^3.7.1",
        "doctrine/orm": "^3.7.0",
        "dragonmantank/cron-expression": "^3.6",
        "easycorp/easyadmin-bundle": "^4.29.16",
        "eightpoints/guzzle-bundle": "^8.9",
        "jbtronics/settings-bundle": ">=3.3.1",
        "knplabs/knp-menu-bundle": "^3.7",
        "league/commonmark": "^2.10.1",
        "league/csv": "^9.28.0",
        "lightsaml2/lightsaml": ">=3.0.1",
        "lightsaml2/sp-bundle": "^5.0",
        "lightsaml2/symfony-bridge": "^6.0",
        "odolbeau/phone-number-bundle": "^4.2.5",
        "openpotato/openplzapi-client": "^0.2.3",
        "phpdocumentor/reflection-docblock": "^5.6.7",
        "phpstan/phpdoc-parser": "^2.3.5",
        "schulit/common-bundle": "^6.2.1",
        "stof/doctrine-extensions-bundle": ">=1.15.3",
        "symfony/apache-pack": ">=1.0.1",
        "symfony/asset": "^7.4.8",
        "symfony/asset-mapper": "^7.4.17",
        "symfony/clock": "^7.4.8",
        "symfony/console": "^7.4.18",
        "symfony/doctrine-messenger": "^7.4.18",
        "symfony/dotenv": "^7.4.18",
        "symfony/expression-language": "^7.4.18",
        "symfony/flex": "^2.11.0",
        "symfony/form": "^7.4.18",
        "symfony/framework-bundle": "^7.4.18",
        "symfony/http-client": "^7.4.18",
        "symfony/intl": "^7.4.17",
        "symfony/mailer": "^7.4.17",
        "symfony/messenger": "^7.4.18",
        "symfony/mime": "^7.4.18",
        "symfony/monolog-bundle": "^3.11.2",
        "symfony/process": "^7.4.18",
        "symfony/property-access": "^7.4.16",
        "symfony/property-info": "^7.4.18",
        "symfony/rate-limiter": "^7.4.18",
        "symfony/runtime": "^7.4.14",
        "symfony/scheduler": "^7.4.17",
        "symfony/security-bundle": "^7.4.18",
        "symfony/serializer": "^7.4.18",
        "symfony/string": "^7.4.15",
        "symfony/translation": "^7.4.17",
        "symfony/twig-bundle": "^7.4.15",
        "symfony/validator": "^7.4.18",
        "symfony/web-link": "^7.4.8",
        "symfony/yaml": "^7.4.18",
        "twig/extra-bundle": "^2.12|^3.24.0",
        "twig/markdown-extra": "^3.28",
        "twig/twig": "^2.12|^3.28.0",
        "zenstruck/messenger-monitor-bundle": "^0.5.4"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.4"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.35",
        "symfony/browser-kit": "^7.4.17",
        "symfony/css-selector": "^7.4.18",
        "symfony/debug-bundle": "^7.4.8",
        "symfony/maker-bundle": "^1.68.0",
        "symfony/stopwatch": "^7.4.8",
        "symfony/web-profiler-bundle": "^7.4.17"
    }
}
